# Copy this file to .env and fill in real values. Never commit the real .env.

SPRING_PROFILES_ACTIVE=dev

# Postgres (e.g. Supabase connection pooler URL for IPv4 compatibility on Render free tier)
DB_URL=jdbc:postgresql://HOST:PORT/DBNAME
DB_USER=
DB_PASS=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT signing secret - long, random, kept secret
JWT_SECRET=

# Frontend origin - used to build password-reset links, link-error redirects, and CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to false only for local HTTP development; must be true in production (HTTPS)
COOKIE_SECURE=true

# Resend (https://resend.com), for password-reset emails. Get an API key from the Resend
# dashboard (starts with re_). Without it, reset requests still return 200 but no email is sent.
RESEND_API_KEY=
# onboarding@resend.dev works out of the box with any Resend account; switch to an address on a
# domain you've verified in Resend once you have one.
MAIL_FROM=onboarding@resend.dev

# --- Scaling / operations ---
# Number of reverse proxies in front of the app that append to X-Forwarded-For. Render = 1.
# 0 ignores the header (safe default when running without a proxy).
TRUSTED_PROXY_HOPS=1
# Secret mixed into stored IP hashes (any long random string). Changing it resets unique-visitor continuity.
IP_HASH_SALT=
# Shared secret for scraping /actuator/prometheus via an X-Metrics-Token header. Blank = endpoint closed.
METRICS_TOKEN=
# Postgres connections per instance. Keep (instances x this) under your DB's connection cap.
DB_POOL_SIZE=5
# Set false on instances that should only serve redirects and not write clicks to Postgres.
CLICK_CONSUMER_ENABLED=true
