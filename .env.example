# Copy this file to .env and fill in real values. Never commit the real .env.

SPRING_PROFILES_ACTIVE=dev

# Postgres (e.g. Supabase connection pooler URL for IPv4 compatibility on Render free tier)
DB_URL=jdbc:postgresql://HOST:PORT/DBNAME
DB_USER=
DB_PASS=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT signing secret - long, random, kept secret
JWT_SECRET=

# Frontend origin - used to build password-reset links, link-error redirects, and CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to false only for local HTTP development; must be true in production (HTTPS)
COOKIE_SECURE=true

# Resend (https://resend.com), for password-reset emails. Get an API key from the Resend
# dashboard (starts with re_). Without it, reset requests still return 200 but no email is sent.
RESEND_API_KEY=
# onboarding@resend.dev works out of the box with any Resend account; switch to an address on a
# domain you've verified in Resend once you have one.
MAIL_FROM=onboarding@resend.dev
